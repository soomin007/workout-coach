<?xml version="1.0" encoding="utf-8"?>
<!-- 운동 중 알림의 펼친 모양 (WorkoutNotice). 남은 시간을 크게, 상태 말은 옅게 옆에 두고,
     긴 운동 이름도 끝까지 보이게 본문을 여러 줄로 둔다. 버튼은 아래에 넓게 두되 앱의 주 버튼처럼 중간 굵기로 쓴다(2026-11-22). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <Chronometer
            android:id="@+id/notice_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="26sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notice_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
    </LinearLayout>

    <TextView
        android:id="@+id/notice_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="3"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Line2" />

    <TextView
        android:id="@+id/notice_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/notice_button"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
